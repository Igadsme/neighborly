# Production environment template.
# NOT LAUNCHED / NOT DEPLOYED. This file is placeholders only.
# Copying it unchanged must fail production boot. That is intentional.
# Put real values in the host secret store. Never commit them.
# .env* is gitignored. A filled copy such as .env.production is covered.
# Do not put these values in GitHub Environment "staging".
# Boot rules: backend/src/common/config/env.validation.ts
# Intended path: docs/PRODUCTION.md

NODE_ENV=production
PORT=3000

# Required. postgresql:// or postgres://. Replace every part.
# Do not use the dev or staging password. Do not point this at
# localhost, staging-postgres, or port 5432/5433.
DATABASE_URL=postgresql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@replace-with-prod-db.example:5432/neighborly

# Required in production. Prefer rediss:// when the provider supports TLS.
# Rate-limit counters only. Not source data.
REDIS_URL=rediss://REPLACE_REDIS_USER:REPLACE_REDIS_PASSWORD@replace-with-prod-redis.example:6380

# Required in production. Exactly 0 or 1.
# 1 only when the edge overwrites X-Forwarded-For with the client address.
# Left empty so an unchanged copy fails boot.
TRUST_PROXY=

# Required. At least 32 characters.
# Production also rejects placeholders (change-me, replace-with, changeme,
# jwt_secret, or the exact words secret, password, neighborly) and any
# value with fewer than 8 distinct characters.
# The value below matches "replace-with" and will not boot. Generate a
# unique secret in the host secret store. Do not reuse the staging JWT.
JWT_SECRET=replace-with-a-production-secret-at-least-32-chars
JWT_ACCESS_TTL=15m

# Required. Comma-separated absolute http(s) origins. "*" is rejected.
# Userinfo in the URL is rejected. Use the public browser origin only.
CORS_ORIGIN=https://replace-with-public-origin.example

# Baked into the web image at build time. Not read by the API.
# Rebuild the web image after this changes. No public origin exists yet.
VITE_API_URL=https://replace-with-public-origin.example/api/v1

# Uploads are unwired. Leave all four empty, or set all four from the
# secret store. A partial set fails boot. S3_REGION defaults to us-east-1
# and is not part of that check. Do not copy MinIO fixture keys here.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Unused. Payments, maps, and email are not wired. Leave blank.
MAPBOX_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Leave empty. captureException logs a JSON line. The Sentry SDK is not
# bundled. If a value is set it must be an https URL, and it still will
# not be delivered until the SDK is added.
SENTRY_DSN=

# Unused. Refresh tokens are not issued. If set, at least 32 characters.
# JWT_REFRESH_SECRET=
# JWT_REFRESH_TTL=7d

# No upload route is mounted. multipart/form-data returns 415.
# MAX_UPLOAD_SIZE_MB is an integer from 1 to 10. Default 5.
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Optional positive integer caps. Defaults: backend/src/common/rate-limit.ts
# RATE_LIMIT_AUTH_REGISTER=5
# RATE_LIMIT_AUTH_LOGIN=10
# RATE_LIMIT_MESSAGING=30
# RATE_LIMIT_LISTINGS=20
# RATE_LIMIT_OFFERS=30
# RATE_LIMIT_REPORTS=10

# Optional. SLOW_QUERY_LOG=1 logs SQL text with placeholders, not bound values.
# SLOW_QUERY_LOG=0
# SLOW_QUERY_MS=200
