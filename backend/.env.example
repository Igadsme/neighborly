# Neighborly API — environment template.
#
# Copy to `.env` for local development, or supply these through your platform's
# secret manager in staging and production. Never commit a filled-in copy.
#
# Values below are placeholders or local-only defaults. Anything marked
# "REQUIRED" has no safe default and must be set explicitly.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Set to 1 ONLY when running behind exactly one reverse proxy. It makes the app
# trust X-Forwarded-For, which clients can otherwise spoof to bypass IP limits.
TRUST_PROXY=0

# ── Required secrets ────────────────────────────────────────────────────────
# REQUIRED. Signing key for access tokens. Use at least 32 random bytes.
JWT_SECRET=replace-with-a-long-random-secret
# REQUIRED. Separate key for refresh tokens. Must differ from JWT_SECRET so that
# a leaked access-token key cannot mint refresh tokens.
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Database ────────────────────────────────────────────────────────────────
# REQUIRED. Use the query parameter form so Prisma selects the right schema.
DATABASE_URL=postgresql://neighborly:neighborly@localhost:5432/neighborly?schema=public
# REQUIRED outside a single-instance local run. Rate-limit counters live here;
# if Redis is down the API degrades rather than losing counters silently.
REDIS_URL=redis://localhost:6379
SLOW_QUERY_LOG=0
SLOW_QUERY_MS=200

# ── HTTP and CORS ───────────────────────────────────────────────────────────
# REQUIRED. Comma-separated allowlist. `*` is refused by the app, because the
# refresh cookie is credentialed and must never be sent to an unknown origin.
CORS_ORIGIN=http://localhost:8443
# Public origin of the web app, used for links in transactional email.
# Production must set PUBLIC_WEB_ORIGIN or verification links point at the wrong host.
PUBLIC_WEB_ORIGIN=http://localhost:8443
# REQUIRED in production: marks session cookies Secure.
# Set to 0 only for local HTTP development.
COOKIE_SECURE=0
# The JSON body limit is a compile-time constant (src/common/http-security.ts),
# not an environment variable. Raising it materially widens the request-body
# attack surface, so it is deliberately not configurable.

# ── Rate limits (per window, per member) ───────────────────────────────────
# Defaults live in src/common/rate-limit.ts. These override them individually.
# The auth limits are the important ones to tune: they are the brute-force
# surface, and they are enforced per IP as well as per account.
RATE_LIMIT_AUTH_LOGIN=10
RATE_LIMIT_AUTH_REGISTER=5
RATE_LIMIT_AUTH_VERIFY=10
RATE_LIMIT_AUTH_RESEND=3
RATE_LIMIT_AUTH_RESET_PASSWORD=5
RATE_LIMIT_AUTH_FORGOT_PASSWORD=5
RATE_LIMIT_LISTINGS=60
RATE_LIMIT_LISTING_IMAGES=20
RATE_LIMIT_OFFERS=20
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_REVIEWS=30
RATE_LIMIT_MESSAGING=60
RATE_LIMIT_MISSIONS=20
RATE_LIMIT_REPORTS=10

# ── Background workers ──────────────────────────────────────────────────────
# Poll intervals in milliseconds. Each worker drains a durable table, so a
# missed tick is recovered on the next one; these tune latency, not durability.
NOTIFICATION_POLL_MS=5000
SAVED_SEARCH_POLL_MS=60000
REVIEW_PUBLISH_POLL_MS=600000
MISSION_REMINDER_POLL_MS=3600000
BORROW_OVERDUE_POLL_MS=300000

# ── Object storage ──────────────────────────────────────────────────────────
# Leave S3_* unset to run without object storage; listing images then fail
# closed rather than being written somewhere unreadable.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=neighborly-media
S3_REGION=us-east-1
S3_ACCESS_KEY=neighborly
S3_SECRET_KEY=replace-me
# Upload guardrails. MAX_UPLOAD_SIZE_MB is enforced in bytes server-side;
# ALLOWED_IMAGE_TYPES is matched against the detected type, never the
# client-supplied Content-Type header.
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/avif

# ── Email ───────────────────────────────────────────────────────────────────
# `outbox` (default) writes messages to a table for later delivery, so a
# fresh environment can complete verification without an external provider.
# `console` logs the message instead. Never use `console` in production.
EMAIL_SENDER=outbox

# ── Third-party (optional) ──────────────────────────────────────────────────
MAPBOX_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# SENTRY_DSN= enables error reporting. Leave empty to disable.
SENTRY_DSN=