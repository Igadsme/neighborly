CORS_ORIGIN=http://localhost:8443
APP_URL=http://localhost:8443
RESEND_API_KEY=
EMAIL_FROM=Neighborly <no-reply@example.com>
MINIO_ROOT_USER=neighborly-dev
MINIO_ROOT_PASSWORD=replace-with-a-local-only-password
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=neighborly-media
