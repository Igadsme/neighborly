generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  SOLD
  ARCHIVED
  DELETED
}

enum RequestStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EXPIRED
  CANCELLED
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum TransactionStatus {
  DRAFT
  PUBLISHED
  OFFER_RECEIVED
  NEGOTIATING
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
  EXPIRED
}

enum ExchangeMode {
  BUY
  BORROW
  RENT
  HIRE
  TRADE
  SKILL_SWAP
  FREE
}

enum PublishStatus {
  PUBLISHED
  ARCHIVED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
}

enum StaffRole {
  MODERATOR
  ADMIN
}

enum ReportTargetType {
  LISTING
  USER
  MESSAGE
  COMMUNITY_POST
}

enum ReportReason {
  SPAM
  SCAM
  HARASSMENT
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationActionKind {
  DISMISS
  RESOLVE
  HIDE
  SUSPEND_USER
  RESTORE_USER
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique
  passwordHash       String
  status             UserStatus           @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  profile            Profile?
  listings           Listing[]
  requests           NeedRequest[]
  offers             RequestOffer[]       @relation("Offerer")
  favorites          Favorite[]
  savedSearches      SavedSearch[]
  preference         UserPreference?
  notificationPreference NotificationPreference?
  conversations      ConversationParticipant[]
  sentMessages       Message[]            @relation("MessageSender")
  reviewsGiven       Review[]             @relation("ReviewAuthor")
  reviewsReceived    Review[]             @relation("ReviewSubject")
  transactionMembers TransactionParticipant[]
  housingListings    HousingListing[]
  jobListings        JobListing[]
  jobApplications    JobApplication[]
  jobSaves           JobSave[]
  serviceListings    ServiceListing[]
  serviceQuotes      ServiceQuote[]
  communityPosts     CommunityPost[]
  communityReactions CommunityReaction[]
  communityComments  CommunityComment[]
  communityEvents    CommunityEvent[]
  eventRsvps         CommunityEventRsvp[]
  lostFoundItems     LostFoundItem[]
  giveaways          Giveaway[]           @relation("GiveawayAuthor")
  claimedGiveaways   Giveaway[]           @relation("GiveawayClaimer")
  staffRoles         StaffRoleAssignment[]
  blocksGiven        BlockedUser[]        @relation("BlocksGiven")
  blocksReceived     BlockedUser[]        @relation("BlocksReceived")
  reportsFiled       Report[]             @relation("ReportsFiled")
  moderationActions  ModerationAction[]
}

model Profile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  firstName    String
  lastName     String
  displayName  String?
  bio          String?
  neighborhood String?
  city         String?
  state        String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  phoneVerified Boolean  @default(false)
  emailVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  interests    Json
  capabilities Json
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  newListings Boolean  @default(true)
  priceDrops  Boolean  @default(true)
  messages    Boolean  @default(true)
  events      Boolean  @default(false)
  community   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  listings  Listing[]
  requests  NeedRequest[]
}

model Listing {
  id                 String          @id @default(uuid()) @db.Uuid
  sellerId           String          @db.Uuid
  categoryId         String          @db.Uuid
  title              String
  description        String
  priceCents         Int?
  condition          String?
  status             ListingStatus   @default(DRAFT)
  neighborhood       String?
  city               String?
  latitude           Decimal?        @db.Decimal(9, 6)
  longitude          Decimal?        @db.Decimal(9, 6)
  radiusMiles        Int?
  pickupAvailable    Boolean         @default(true)
  deliveryAvailable  Boolean         @default(false)
  shippingAvailable  Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  seller             User            @relation(fields: [sellerId], references: [id])
  category           Category        @relation(fields: [categoryId], references: [id])
  images             ListingImage[]
  favorites          Favorite[]
  offerItems         OfferItem[]
  matches            RequestMatch[]
  priceHistory       PriceHistory[]

  @@index([status, categoryId, createdAt])
  @@index([sellerId, status])
  @@index([city, neighborhood])
}

model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @db.Uuid
  objectKey String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

model SavedSearch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  query     String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NeedRequest {
  id          String        @id @default(uuid()) @db.Uuid
  requesterId String        @db.Uuid
  categoryId  String        @db.Uuid
  title       String
  description String
  budgetCents Int?
  latitude    Decimal?      @db.Decimal(9, 6)
  longitude   Decimal?      @db.Decimal(9, 6)
  radiusMiles Int           @default(10)
  deadline    DateTime?
  urgency     String?
  mode        ExchangeMode
  status      RequestStatus  @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  requester   User           @relation(fields: [requesterId], references: [id])
  category    Category       @relation(fields: [categoryId], references: [id])
  offers      RequestOffer[]
  matches     RequestMatch[]

  @@index([requesterId, status, createdAt])
  @@index([categoryId, status])
}

model RequestOffer {
  id          String          @id @default(uuid()) @db.Uuid
  requestId   String          @db.Uuid
  offererId   String          @db.Uuid
  amountCents Int?
  message     String
  status      OfferStatus     @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  request     NeedRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offerer     User            @relation("Offerer", fields: [offererId], references: [id])
  items       OfferItem[]
  counterOffers CounterOffer[]

  @@index([requestId, status, createdAt])
  @@index([offererId, status])
}

model OfferItem {
  id        String       @id @default(uuid()) @db.Uuid
  offerId   String       @db.Uuid
  listingId String       @db.Uuid
  offer     RequestOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  listing   Listing      @relation(fields: [listingId], references: [id])

  @@unique([offerId, listingId])
}

model CounterOffer {
  id          String       @id @default(uuid()) @db.Uuid
  offerId     String       @db.Uuid
  fromUserId  String       @db.Uuid
  amountCents Int?
  message     String
  createdAt   DateTime     @default(now())
  offer       RequestOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model RequestMatch {
  id        String       @id @default(uuid()) @db.Uuid
  requestId String       @db.Uuid
  listingId String       @db.Uuid
  score     Decimal      @db.Decimal(5, 2)
  createdAt DateTime     @default(now())
  request   NeedRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([requestId, listingId])
}

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
  transactions Transaction[]
}

model ConversationParticipant {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  body           String
  hiddenAt       DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Transaction {
  id             String                    @id @default(uuid()) @db.Uuid
  conversationId String?                   @db.Uuid
  offerId        String?                   @db.Uuid
  status         TransactionStatus         @default(DRAFT)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  conversation   Conversation?             @relation(fields: [conversationId], references: [id])
  participants   TransactionParticipant[]
  milestones     TransactionMilestone[]
  appointments   Appointment[]
  reviews        Review[]
}

model TransactionParticipant {
  transactionId String      @db.Uuid
  userId        String      @db.Uuid
  role          String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@id([transactionId, userId])
}

model TransactionMilestone {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @db.Uuid
  fromStatus    TransactionStatus?
  toStatus      TransactionStatus
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Appointment {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @db.Uuid
  startsAt      DateTime
  locationNote  String?
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Review {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @db.Uuid
  authorId      String      @db.Uuid
  subjectId     String      @db.Uuid
  rating        Int
  body          String
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  author        User        @relation("ReviewAuthor", fields: [authorId], references: [id])
  subject       User        @relation("ReviewSubject", fields: [subjectId], references: [id])
}

model PriceHistory {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @db.Uuid
  priceCents Int?
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model HousingListing {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String        @db.Uuid
  title        String
  description  String
  propertyType String
  listingType  String
  priceCents   Int
  priceUnit    String?
  beds         Int
  baths        Int
  sqft         Int           @default(0)
  neighborhood String?
  city         String?
  available    String?
  lease        String?
  pets         Boolean       @default(false)
  furnished    Boolean       @default(false)
  utilities    String?
  verified     Boolean       @default(false)
  status       PublishStatus @default(PUBLISHED)
  latitude     Decimal?      @db.Decimal(9, 6)
  longitude    Decimal?      @db.Decimal(9, 6)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  owner        User          @relation(fields: [ownerId], references: [id])
  images       HousingImage[]

  @@index([status, listingType, createdAt])
  @@index([ownerId, status])
  @@index([city, neighborhood])
}

model HousingImage {
  id        String         @id @default(uuid()) @db.Uuid
  housingId String         @db.Uuid
  objectKey String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  housing   HousingListing @relation(fields: [housingId], references: [id], onDelete: Cascade)

  @@index([housingId, sortOrder])
}

model JobListing {
  id               String        @id @default(uuid()) @db.Uuid
  ownerId          String        @db.Uuid
  title            String
  company          String
  logoKey          String?
  description      String
  responsibilities String[]      @default([])
  employmentType   String
  level            String
  salary           String
  location         String
  remote           String
  deadline         String?
  tags             String[]      @default([])
  verified         Boolean       @default(false)
  status           PublishStatus @default(PUBLISHED)
  latitude         Decimal?      @db.Decimal(9, 6)
  longitude        Decimal?      @db.Decimal(9, 6)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  owner            User          @relation(fields: [ownerId], references: [id])
  applications     JobApplication[]
  saves            JobSave[]

  @@index([status, employmentType, createdAt])
  @@index([ownerId, status])
}

model JobApplication {
  id          String     @id @default(uuid()) @db.Uuid
  jobId       String     @db.Uuid
  applicantId String     @db.Uuid
  message     String?
  createdAt   DateTime   @default(now())
  job         JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant   User       @relation(fields: [applicantId], references: [id])

  @@unique([jobId, applicantId])
  @@index([applicantId, createdAt])
}

model JobSave {
  userId    String     @db.Uuid
  jobId     String     @db.Uuid
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([jobId])
}

model ServiceListing {
  id                 String        @id @default(uuid()) @db.Uuid
  ownerId            String        @db.Uuid
  title              String
  businessName       String
  description        String
  category           String
  startingPriceCents Int
  location           String
  availability       String
  tags               String[]      @default([])
  imageKey           String?
  backgroundCheck    Boolean       @default(false)
  rating             Decimal?      @db.Decimal(2, 1)
  reviewCount        Int           @default(0)
  status             PublishStatus @default(PUBLISHED)
  latitude           Decimal?      @db.Decimal(9, 6)
  longitude          Decimal?      @db.Decimal(9, 6)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?
  owner              User          @relation(fields: [ownerId], references: [id])
  quotes             ServiceQuote[]

  @@index([status, category, createdAt])
  @@index([ownerId, status])
}

model ServiceQuote {
  id            String         @id @default(uuid()) @db.Uuid
  serviceId     String         @db.Uuid
  requesterId   String         @db.Uuid
  preferredDate String?
  preferredTime String?
  notes         String
  address       String?
  status        QuoteStatus    @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  service       ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  requester     User           @relation(fields: [requesterId], references: [id])

  @@index([serviceId, status, createdAt])
  @@index([requesterId, createdAt])
}

model CommunityPost {
  id           String             @id @default(uuid()) @db.Uuid
  authorId     String             @db.Uuid
  type         String
  title        String
  body         String
  neighborhood String?
  city         String?
  status       PublishStatus      @default(PUBLISHED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  author       User               @relation(fields: [authorId], references: [id])
  reactions    CommunityReaction[]
  comments     CommunityComment[]

  @@index([status, type, createdAt])
  @@index([authorId, status])
  @@index([neighborhood])
}

model CommunityReaction {
  postId    String        @db.Uuid
  userId    String        @db.Uuid
  emoji     String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model CommunityComment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @db.Uuid
  authorId  String        @db.Uuid
  body      String
  createdAt DateTime      @default(now())
  deletedAt DateTime?
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id])

  @@index([postId, createdAt])
}

model CommunityEvent {
  id           String              @id @default(uuid()) @db.Uuid
  organizerId  String              @db.Uuid
  title        String
  description  String?
  neighborhood String?
  city         String?
  dateLabel    String
  timeLabel    String
  imageKey     String?
  status       PublishStatus       @default(PUBLISHED)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  organizer    User                @relation(fields: [organizerId], references: [id])
  rsvps        CommunityEventRsvp[]

  @@index([status, createdAt])
  @@index([organizerId, status])
}

model CommunityEventRsvp {
  eventId   String         @db.Uuid
  userId    String         @db.Uuid
  createdAt DateTime       @default(now())
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

model LostFoundItem {
  id           String        @id @default(uuid()) @db.Uuid
  authorId     String        @db.Uuid
  kind         String
  item         String
  neighborhood String?
  city         String?
  imageKey     String?
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  author       User          @relation(fields: [authorId], references: [id])

  @@index([status, kind, createdAt])
  @@index([authorId, status])
}

model Giveaway {
  id           String        @id @default(uuid()) @db.Uuid
  authorId     String        @db.Uuid
  item         String
  neighborhood String?
  city         String?
  claimed      Boolean       @default(false)
  claimedById  String?       @db.Uuid
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  author       User          @relation("GiveawayAuthor", fields: [authorId], references: [id])
  claimedBy    User?         @relation("GiveawayClaimer", fields: [claimedById], references: [id])

  @@index([status, claimed, createdAt])
  @@index([authorId, status])
}

model StaffRoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  role      StaffRole
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model BlockedUser {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @db.Uuid
  targetType ReportTargetType
  targetId   String           @db.Uuid
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  reporter   User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  actions    ModerationAction[]

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationAction {
  id        String               @id @default(uuid()) @db.Uuid
  reportId  String               @db.Uuid
  actorId   String               @db.Uuid
  kind      ModerationActionKind
  note      String?
  createdAt DateTime             @default(now())
  report    Report               @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor     User                 @relation(fields: [actorId], references: [id])

  @@index([reportId, createdAt])
  @@index([actorId])
}
