# Staging environment template.
# Copy to .env.staging (gitignored by `.env*`). scripts/staging-up.sh does that
# and fills an empty JWT_SECRET. Do not commit .env.staging.
# Values below are local Compose fixtures. They are not production secrets.
# Put a long-lived staging JWT only in .env.staging or in the GitHub
# Environment named `staging` (secret name STAGING_JWT_SECRET). Never commit it.

NODE_ENV=production
PORT=3000
APP_ENV=staging

# Hostname is the Compose service, not the host-published port.
DATABASE_URL=postgresql://neighborly:neighborly@staging-postgres:5432/neighborly
REDIS_URL=redis://staging-redis:6379
# Caddy overwrites X-Forwarded-For. The API port is bound to loopback only.
TRUST_PROXY=1

# Leave empty in this template. scripts/staging-up.sh writes a staging-only value.
JWT_SECRET=
JWT_ACCESS_TTL=15m

# Browser origin. Caddy serves this host with its internal CA on port 8444.
CORS_ORIGIN=https://staging.neighborly.localhost:8444
# Baked into the frontend image at build time. Rebuild `web` after changing it.
VITE_API_URL=https://staging.neighborly.localhost:8444/api/v1

# Local MinIO. The API accepts a complete set and does not upload yet.
# These match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.yml.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=neighborly-media
S3_REGION=us-east-1
S3_ACCESS_KEY=neighborly-staging
S3_SECRET_KEY=neighborly-staging-local-only

# Unused by this release. Leave blank.
MAPBOX_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
