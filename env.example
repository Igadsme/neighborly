# Neighborly local environment.
# Copy to backend/.env before starting the API.
# Copy to .env at the repo root so Vite can read VITE_API_URL.
# Real .env files are gitignored; this template is safe to commit.

NODE_ENV=development
PORT=3000

# Required to boot the API.
DATABASE_URL=postgresql://neighborly:neighborly@localhost:5432/neighborly
JWT_SECRET=replace-with-a-local-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-another-local-secret-32-chars
JWT_REFRESH_TTL=7d
# Vite in this repo listens on $PORT or 8443, not 5173.
CORS_ORIGIN=http://localhost:8443
APP_URL=http://localhost:8443
RESEND_API_KEY=
EMAIL_FROM=Neighborly <no-reply@example.com>

# Redis shares rate limits across API processes and is checked by readiness.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Required for listing image upload. These local values must not be reused in production.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=neighborly-media
S3_REGION=us-east-1
S3_ACCESS_KEY=neighborly
S3_SECRET_KEY=replace-with-a-local-only-password
S3_PUBLIC_URL=http://localhost:9000/neighborly-media
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Frontend. Read from the repo-root .env by `pnpm dev`.
VITE_API_URL=http://localhost:3000/api/v1
