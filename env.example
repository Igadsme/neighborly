# Neighborly environment template.
# Copy to backend/.env before starting the API.
# Copy VITE_API_URL to .env at the repo root so Vite can read it.
# Real .env files match .env* in .gitignore and are not committed.
# This file is the local development template. Staging uses env.staging.example.
# Put no live secrets here.

NODE_ENV=development
PORT=3000

# Required to boot the API in every environment.
DATABASE_URL=postgresql://neighborly:neighborly@localhost:5432/neighborly
JWT_SECRET=replace-with-a-local-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
# Comma-separated absolute http(s) origins. `*` is rejected.
# Vite in this repo listens on $PORT or 8443, not 5173.
CORS_ORIGIN=http://localhost:8443

# Production boot (NODE_ENV=production) also requires:
# - REDIS_URL (rate limits are shared; an outage falls back per process and /ready fails)
# - TRUST_PROXY=1 or 0. Use 1 only when the proxy overwrites X-Forwarded-For.
# - JWT_SECRET at least 32 characters, not a placeholder, and not low-diversity.
# Swagger at /docs is off in production. Cookies are not used.

# Optional outside production. Prefer Redis whenever more than one API process runs.
# REDIS_URL=redis://localhost:6379
# TRUST_PROXY=0

# Optional. Refresh tokens are not issued.
# JWT_REFRESH_SECRET=
# JWT_REFRESH_TTL=7d

# Optional until an object-storage client exists. Set all four or none.
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=neighborly-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Optional. Payments and maps are not wired. Leave blank.
MAPBOX_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. The API logs structured errors. Forwarding to Sentry is a hook, not a bundled SDK.
SENTRY_DSN=

# No upload route is mounted. These bound the future image check and are rejected above 10 MB.
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Optional positive integer caps. Defaults live in backend/src/common/rate-limit.ts.
# RATE_LIMIT_AUTH_REGISTER=5
# RATE_LIMIT_AUTH_LOGIN=10
# RATE_LIMIT_MESSAGING=30
# RATE_LIMIT_LISTINGS=20
# RATE_LIMIT_OFFERS=30
# RATE_LIMIT_REPORTS=10

# Optional. SLOW_QUERY_LOG=1 emits a warning for Prisma queries at or above SLOW_QUERY_MS.
# The log line includes the SQL text with placeholders, not bound parameters.
# SLOW_QUERY_LOG=0
# SLOW_QUERY_MS=200

# Frontend. Read from the repo-root .env by `pnpm dev`.
VITE_API_URL=http://localhost:3000/api/v1
