# Neighborly local environment.
# Copy to backend/.env before starting the API.
# Copy to .env at the repo root so Vite can read VITE_API_URL.
# Real .env files are gitignored; this template is safe to commit.

NODE_ENV=development
PORT=3000

# Required to boot the API.
DATABASE_URL=postgresql://neighborly:neighborly@localhost:5432/neighborly
JWT_SECRET=replace-with-a-local-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
# Vite in this repo listens on $PORT or 8443, not 5173.
CORS_ORIGIN=http://localhost:8443

# Optional. Refresh tokens are not issued yet, so the API does not read this.
# JWT_REFRESH_SECRET=replace-with-another-local-secret-32-chars
# JWT_REFRESH_TTL=7d

# Optional until a Redis client exists. docker compose still starts Redis.
# REDIS_URL=redis://localhost:6379

# Optional until an S3 client exists.
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=neighborly-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY=neighborly
# S3_SECRET_KEY=neighborly-secret

# Frontend. Read from the repo-root .env by `pnpm dev`.
VITE_API_URL=http://localhost:3000/api/v1
